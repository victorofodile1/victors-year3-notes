  "neonate": "A baby in the first 28 days of life.",
  "respiratory distress": "Struggling to breathe, with fast breathing and use of extra muscles.",
  "per rectum": "Examined through the rectum (digital rectal exam).",
  "recurrence": "The hernia coming back after repair.",
  "superomedial thigh": "Upper inner part of the thigh.",
  "labia": "The folds of skin around the vaginal opening.",
  "elective": "Planned in advance, not an emergency.",
  "paediatric surgery": "Surgery for babies and children.",
  "congenital": "Present from birth.",
