 "glossary": {
  "Vitamin B1": "Another name for thiamine, a water-soluble vitamin with small body stores.",
  "Chronic alcoholism": "Long-term heavy alcohol dependence.",
  "Starvation": "Severe prolonged lack of food, depleting vitamin stores.",
  "GI": "Gastrointestinal: relating to the gut.",
  "Triad": "Three features that occur together and point to a diagnosis.",
  "Lateral rectus palsy": "Weakness of the eye muscle that turns the eye outwards (sixth nerve), causing a squint and double vision.",
  "Short-term memory": "Memory for recent events and new information.",
  "Unsteady gait": "Wobbly, broad-based walking from ataxia.",
  "Disorientation": "Not knowing the time, place or one's situation.",
  "Amnesia": "Loss of memory.",
  "IV": "Intravenous: given directly into a vein.",
  "Parenterally": "Given by a route other than the gut, such as IV or IM injection.",
  "Parenteral": "Given other than by mouth, such as IV or IM.",
  "Hypoglycaemic": "Having a low blood glucose.",
  "Hypoglycaemia": "Low blood glucose; correcting it is the immediate priority.",
  "Harmful alcohol intake": "Drinking that is already causing physical or mental harm.",
  "Malnourishment": "Poor nutrition from inadequate diet or absorption.",
  "Decompensated liver disease": "Cirrhosis with complications such as jaundice, ascites, encephalopathy or bleeding varices.",
  "Medically assisted withdrawal": "Supervised alcohol detox, usually with chlordiazepoxide, plus thiamine.",
  "Cofactor": "A helper molecule an enzyme needs to work.",
  "Glucose metabolism": "Breakdown of glucose to release energy (ATP) in cells.",
  "Neuronal": "Relating to nerve cells.",
  "Metabolic turnover": "How fast a tissue uses energy and nutrients.",
  "Hepatic": "Relating to the liver.",
  "Intestinal absorption": "Uptake of nutrients from the gut into the blood.",
  "MRI": "Magnetic resonance imaging; brain scan that may show mamillary body changes but is not needed.",
  "Dependence": "Compulsion to drink with withdrawal symptoms on stopping.",
  "Irreversible": "Cannot be undone or recovered from.",
  "Supportive care": "Treatment keeping the patient safe and stable, e.g. fluids and nutrition.",
  "Gait": "The pattern of walking.",
  "Alcohol cessation": "Stopping drinking alcohol.",
  "Capillary glucose": "Finger-prick blood sugar test.",
  "Grey matter": "Brain tissue made mostly of neuron cell bodies."
 }
