  "glossary": {
    "Asymptomatic": "Having no symptoms.",
    "Morbidity": "Illness or ill health from a disease.",
    "Mortality": "Death from a disease.",
    "Vaccination": "Giving a vaccine to train the immune system to prevent an infection.",
    "Smoking cessation": "Stopping smoking.",
    "Rehabilitation": "Treatment to help regain function and independence.",
    "Ultrasound": "Imaging that uses high-frequency sound waves to show soft tissues.",
    "Recall": "Inviting a person back for their next routine screening test.",
    "Smear": "A sample of cells taken from the cervix for testing.",
    "Cytologically": "Judged by looking at cells under a microscope.",
    "Low-grade dyskaryosis": "Mildly abnormal cervical cells that may progress and need colposcopy.",
    "Inadequate sample": "A sample that cannot be read reliably, so must be repeated.",
    "Hepatitis B": "A blood-borne virus infecting the liver that can pass from mother to baby.",
    "HIV": "Human immunodeficiency virus, which damages the immune system.",
    "Rubella": "German measles: a viral infection that can cause birth defects in early pregnancy.",
    "Syphilis": "A sexually transmitted bacterial infection that can infect the baby in pregnancy.",
    "Intermenstrual bleeding": "Vaginal bleeding between periods.",
    "Postcoital bleeding": "Vaginal bleeding after sex.",
    "Red flags": "Warning features suggesting serious disease that need urgent action.",
    "Gynaecological": "Relating to the female reproductive organs.",
    "FP": "False positive: a positive test in someone without the disease.",
    "TN": "True negative: a negative test in someone without the disease.",
    "Confirmatory test": "A more definite test used after a positive screen to make the diagnosis.",
    "Latent stage": "An early phase when disease is present but causes no symptoms.",
    "Eligible population": "The group of people a screening programme is offered to.",
    "Early intervention": "Treatment started at an early stage to stop progression.",
    "Excision": "Surgical cutting out of tissue.",
    "Preclinical phase": "The period when disease exists but has not yet produced symptoms.",
    "Threshold": "The cut-off value above which a test is called positive.",
    "Trade-off": "Gaining one thing at the cost of another.",
    "Predictive values": "PPV and NPV: the chance a positive or negative result is correct.",
    "Epidemiological": "Relating to the patterns and causes of disease in populations.",
    "Health-economic": "Relating to the costs and benefits of health interventions.",
    "Net benefit": "Overall good once harms are subtracted from benefits.",
    "Abdominal aortic aneurysm": "A ballooning of the aorta in the abdomen that can rupture."
  }
}